{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-capability-map.invalid/schemas/v1/evidence.schema.json",
  "title": "Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "subject_id", "claim_path", "source_url", "source_type", "source_grade", "verification_state"],
  "properties": {
    "id": {"type": "string", "pattern": "^ev_[a-z0-9]+(?:_[a-z0-9]+)*$"},
    "subject_id": {"type": "string", "minLength": 1},
    "claim_path": {"type": "string", "pattern": "^/[^\\s]*$"},
    "source_url": {"type": "string", "format": "uri"},
    "source_type": {"enum": ["official_docs", "official_spec", "official_repo", "package_registry", "official_notice", "third_party", "unknown"]},
    "source_grade": {"enum": ["A", "B", "C", "D"]},
    "verification_state": {"enum": ["verified", "unverified", "needs_review", "stale", "contradicted"]},
    "verified_at": {"type": "string", "format": "date-time"},
    "source_locator": {"type": "string"},
    "verification_method": {"type": "string"}
  }
}
